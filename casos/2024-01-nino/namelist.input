&time_control
 run_days = 0, run_hours = 48, run_minutes = 0, run_seconds = 0,
 start_year = 2024, start_month = 01, start_day = 22, start_hour = 00,
 end_year   = 2024, end_month   = 01, end_day   = 24, end_hour   = 00,
 interval_seconds   = 21600,
 input_from_file    = .true.,
 history_interval   = 180,
 frames_per_outfile = 1000,
 restart            = .false.,
 restart_interval   = 100000,
 io_form_history = 2, io_form_restart = 2, io_form_input = 2, io_form_boundary = 2,
/

&domains
 time_step = 90,
 max_dom = 1,
 e_we = 80, e_sn = 80, e_vert = 45,
 p_top_requested = 5000,
 num_metgrid_levels = 34,
 num_metgrid_soil_levels = 4,
 dx = 15000, dy = 15000,
 grid_id = 1, parent_id = 0,
 i_parent_start = 1, j_parent_start = 1,
 parent_grid_ratio = 1, parent_time_step_ratio = 1,
 feedback = 0,
/

&physics
 mp_physics         = 8,
 cu_physics         = 1,
 ra_lw_physics      = 4,
 ra_sw_physics      = 4,
 radt               = 15,
 bl_pbl_physics     = 1,
 sf_sfclay_physics  = 1,
 sf_surface_physics = 2,
 num_land_cat       = 21,
/

&dynamics
 w_damping = 1, diff_opt = 1, km_opt = 4,
 damp_opt = 3, zdamp = 5000., dampcoef = 0.2,
/

&bdy_control
 spec_bdy_width = 5, specified = .true.,
/

&namelist_quilt
 nio_tasks_per_group = 0, nio_groups = 1,
/
