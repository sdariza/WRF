&share
 wrf_core = 'ARW',
 max_dom = 1,
 start_date = '2026-11-19_00:00:00',
 end_date   = '2026-11-21_00:00:00',
 interval_seconds = 21600,
/

&geogrid
 parent_id         = 1,
 parent_grid_ratio = 1,
 i_parent_start    = 1,
 j_parent_start    = 1,
 e_we              = 80,
 e_sn              = 80,
 geog_data_res     = 'lowres',
 dx = 15000,
 dy = 15000,
 map_proj  = 'mercator',
 ref_lat   = 9.5,
 ref_lon   = -74.5,
 truelat1  = 10.0,
 stand_lon = -74.5,
 geog_data_path = '/workspaces/modelo/WPS_GEOG_LOW_RES'
/

&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/

&metgrid
 fg_name = 'FILE'
/
